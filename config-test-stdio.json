{
  "$schema": "./schema/config-schema.json",
  "version": "2.0",
  "useStdIOClient": true,
  "slack": {
    "botToken": "${SLACK_BOT_TOKEN}",
    "appToken": "${SLACK_APP_TOKEN}",
    "messageHistory": 50,
    "thinkingMessage": "Thinking..."
  },
  "llm": {
    "provider": "openai",
    "useAgent": true,
    "useNativeTools": true,
    "maxAgentIterations": 20,
    "customPrompt": "You are a helpful assistant that can use tools to help users. When you need to use multiple tools, do so step by step and explain what you're doing.",
    "providers": {
      "openai": {
        "model": "${LITELLM_MODEL}",
        "apiKey": "${OPENAI_API_KEY}",
        "baseUrl": "${LITELLM_BASE_URL}",
        "temperature": 0.7,
        "maxTokens": 4000
      }
    }
  },
  "mcpServers": {
    "orby": {
      "url": "http://localhost:8080/mcp/orby",
      "transport": "http"
    }
  },
  "monitoring": {
    "enabled": true,
    "metricsPort": 8081,
    "loggingLevel": "debug"
  },
  "observability": {
    "enabled": false,
    "provider": "disabled"
  }
}
