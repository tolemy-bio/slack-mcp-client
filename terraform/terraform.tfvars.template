# Orby Slack Client - Terraform Variables
# Copy this to terraform.tfvars and fill in your values

project_id = "gen-lang-client-0335698828"
region     = "europe-west1"
zone       = "europe-west1-b"

# Machine type (e2-micro is free tier eligible)
machine_type = "e2-micro"

# No secret goes in this file or in instance metadata. Slack, LiteLLM, Notion, Linear and
# the other credentials live in Secret Manager as orby-<name> (see main.tf); add each with
#   printf %s "$VALUE" | gcloud secrets versions add orby-<name> --data-file=-

# LiteLLM
litellm_base_url = "https://litellm.tolemy.bio/v1"
# litellm_model  = "claude-sonnet-4-5"  # (default)

# NewsWatch admin sign-in
# newswatch_google_client_id = "<client id>.apps.googleusercontent.com"

# MCP server
# mcp_server_url  = "http://127.0.0.1:8081/mcp/orby"  # (default)
# rag_persist_dir = "/var/lib/orby/chroma"            # (default)
